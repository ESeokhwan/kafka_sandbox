{
  "apiKey": 99,
  "type": "request",
  "name": "ReadGlobalSequenceDataRequest",
  "validVersions": "0",
  "flexibleVersions": "0+",
  "listeners": [
    "broker"
  ],
  "fields": [
    {
      "name": "TopicId",
      "type": "uuid",
      "versions": "0+",
      "about": "The global sequence data topic UUID."
    },
    {
      "name": "Partition",
      "type": "int32",
      "versions": "0+",
      "about": "The source partition."
    },
    {
      "name": "PhysicalBaseOffset",
      "type": "int64",
      "versions": "0+",
      "about": "The complete physical batch base."
    },
    {
      "name": "PhysicalLastOffset",
      "type": "int64",
      "versions": "0+",
      "about": "The inclusive physical batch last offset."
    },
    {
      "name": "RecordCount",
      "type": "int32",
      "versions": "0+",
      "about": "The full batch record count."
    },
    {
      "name": "SourceLeaderEpoch",
      "type": "int32",
      "versions": "0+",
      "about": "Required current data leader epoch.",
      "default": -1
    },
    {
      "name": "TimeoutMs",
      "type": "int32",
      "versions": "0+",
      "about": "Remaining timeout from 1 to 30000 milliseconds.",
      "default": 5000
    }
  ]
}
