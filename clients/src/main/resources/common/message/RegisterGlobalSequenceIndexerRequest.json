{
  "apiKey": 93,
  "type": "request",
  "listeners": [
    "broker"
  ],
  "name": "RegisterGlobalSequenceIndexerRequest",
  "validVersions": "0",
  "flexibleVersions": "0+",
  "fields": [
    {
      "name": "TopicId",
      "type": "uuid",
      "versions": "0+",
      "about": "The data topic identifier."
    },
    {
      "name": "Partition",
      "type": "int32",
      "versions": "0+",
      "about": "The data partition index."
    },
    {
      "name": "SourceBrokerId",
      "type": "int32",
      "versions": "0+",
      "about": "The current data leader broker."
    },
    {
      "name": "SourceLeaderEpoch",
      "type": "int32",
      "versions": "0+",
      "about": "The data leader epoch."
    },
    {
      "name": "ExpectedGeneration",
      "type": "int64",
      "versions": "0+",
      "about": "The previously observed generation, or -1 for initial registration.",
      "default": -1
    },
    {
      "name": "RegistrationId",
      "type": "uuid",
      "versions": "0+",
      "about": "The UUID preserved across retries of this registration."
    },
    {
      "name": "CoordinatorLeaderEpoch",
      "type": "int32",
      "versions": "0+",
      "about": "The expected index leader epoch, or -1 if not supplied.",
      "default": -1
    }
  ]
}
